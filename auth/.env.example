# Copy this file to `.env` in the `auth/` folder and fill in real
# values from your Firebase project to enable real authentication
# (email/password, Google, Microsoft, and phone OTP sign-in).
#
# Where to get these:
#   1. https://console.firebase.google.com -> create/select a project
#   2. Project settings -> General -> "Your apps" -> add a Web app
#      -> copy the config values below.
#   3. Authentication -> Sign-in method -> enable:
#        - Email/Password
#        - Google
#        - Microsoft   (needs an Azure AD app registration; Firebase's
#                        console walks you through this)
#        - Phone
#   4. Authentication -> Settings -> Authorized domains -> add your
#      production domain (and localhost for local dev).
#
# Vite only exposes vars prefixed VITE_ to client code, and only
# embeds them at BUILD time - so on Vercel/Netlify/Render you must
# set these in the project's Environment Variables settings and
# redeploy (a plain restart won't pick up new values).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
